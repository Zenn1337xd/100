    local RARITY_RANKS = {
        ["secret"]    = {Tier = "Secret", Rank = 10, Color = Color3.fromRGB(0, 255, 210)},
        ["eternal"]   = {Tier = "Eternal", Rank = 9, Color = Color3.fromRGB(255, 60, 180)},
