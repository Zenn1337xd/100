local RARE_DATABASE = {
    ["cherub"]     = {Name = "Cherub Egg", Tier = "Ethereal", Color = Color3.fromRGB(255, 215, 0), Rank = 8},
    ["solaris"]    = {Name = "Solaris Egg", Tier = "Ethereal", Color = Color3.fromRGB(255, 85, 30), Rank = 7},
    ["blackhole"]  = {Name = "Black Hole Egg", Tier = "Ethereal", Color = Color3.fromRGB(170, 50, 255), Rank = 6},
    ["black hole"] = {Name = "Black Hole Egg", Tier = "Ethereal", Color = Color3.fromRGB(170, 50, 255), Rank = 6},
    ["galaxy"]     = {Name = "Galaxy Egg", Tier = "Mythic", Color = Color3.fromRGB(185, 80, 255), Rank = 5},
    ["aurora"]     = {Name = "Aurora Egg", Tier = "Divine", Color = Color3.fromRGB(0, 220, 255), Rank = 4},
    ["soul"]       = {Name = "Soul Egg", Tier = "Divine", Color = Color3.fromRGB(50, 160, 255), Rank = 3},
    ["sinister"]   = {Name = "Sinister Egg", Tier = "Mythic", Color = Color3.fromRGB(230, 30, 100), Rank = 3},
    ["flaming"]    = {Name = "Flaming Egg", Tier = "Divine", Color = Color3.fromRGB(255, 140, 0), Rank = 2},
    ["devilicious"]= {Name = "Devilicious Egg", Tier = "Legendary", Color = Color3.fromRGB(255, 50, 50), Rank = 1},
    ["skull"]      = {Name = "Skull Egg", Tier = "Legendary", Color = Color3.fromRGB(210, 180, 255), Rank = 1}
}

local function scanRares()
    local list = {}
    local home = getMyBasePos()
    local root = character and character:FindFirstChild("HumanoidRootPart")

    for _, obj in ipairs(workspace:GetChildren()) do
        local nameLower = string.lower(obj.Name)
        local match = nil

        for key, data in pairs(RARE_DATABASE) do
            if string.find(nameLower, key) then
                match = data
                break
            end
        end

        if not match and (string.find(nameLower, "egg") or obj:FindFirstChildWhichIsA("ProximityPrompt", true)) then
            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                local text = string.lower((prompt.ObjectText or "") .. " " .. (prompt.ActionText or ""))
                for key, data in pairs(RARE_DATABASE) do
                    if string.find(text, key) then
                        match = data
                        break
                    end
                end
            end
        end

        if match then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
            if part and (part.Position - home).Magnitude > 50 then
                local dist = root and math.floor((root.Position - part.Position).Magnitude * 0.28) or 0
                table.insert(list, {
                    Object = obj,
                    Part = part,
                    Name = match.Name,
                    Tier = match.Tier,
                    Color = match.Color,
                    Rank = match.Rank,
                    Distance = dist
                })
            end
        end
    end

    table.sort(list, function(a, b) return a.Rank > b.Rank end)
    return list
end

