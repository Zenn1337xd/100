    end)

    local radarContainer = createCategoryCard(pEggs, "Live Spawned Eggs (All Zones)")

    local function refreshRadarDisplay()
        for _, child in ipairs(radarContainer:GetChildren()) do
            if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                child:Destroy()
            end
        end

        local eggs = scanAllEggs()

        if #eggs == 0 then
            local empty = Instance.new("TextLabel")
            empty.Size = UDim2.new(0.94, 0, 0, 32)
            empty.BackgroundTransparency = 1
            empty.Text = "No unowned eggs in map/zones. Watching for spawns..."
