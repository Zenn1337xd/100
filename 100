local speedEnabled = false
local currentSpeed = 500
local infJump = false
local autoSteal = false
local isStealing = false

-- Speed Loop
local speedConn
local function updateSpeed()
    if speedConn then speedConn:Disconnect() speedConn = nil end
    if speedEnabled then
        speedConn = RunService.Heartbeat:Connect(function()
            if character and character:FindFirstChildWhichIsA("Humanoid") then
                local hum = character:FindFirstChildWhichIsA("Humanoid")
                hum.WalkSpeed = currentSpeed
                if hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
                    hum.SeatPart.MaxSpeed = currentSpeed
                    hum.SeatPart.ThrottleFloat = 1
                end
            end
        end)
    else
        if character and character:FindFirstChildWhichIsA("Humanoid") then
            character:FindFirstChildWhichIsA("Humanoid").WalkSpeed = 16
        end
    end
end

-- Jump Loop
local jumpConn
local function setJump(enabled)
    if jumpConn then jumpConn:Disconnect() jumpConn = nil end
    if enabled then
        jumpConn = UserInputService.JumpRequest:Connect(function()
            if character and character:FindFirstChildWhichIsA("Humanoid") then
                character:FindFirstChildWhichIsA("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end

-- Instant 1s Steal Routine
local function doSteal(data)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not data.Part or not data.Part.Parent then return end

    local home = getMyBasePos()
    stabilize()

    -- 1. TP to Egg
    root.CFrame = data.Part.CFrame * CFrame.new(0, 3, 0)
    stabilize()
    task.wait(0.15)

    -- 2. Trigger Pickup
    local prompt = data.Object:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        if fireproximityprompt then fireproximityprompt(prompt, 0) end
        prompt:InputHoldBegin()
        task.wait(0.2)
        prompt:InputHoldEnd()
    end
    if firetouchinterest then
        pcall(function()
            firetouchinterest(root, data.Part, 0)
            task.wait(0.05)
            firetouchinterest(root, data.Part, 1)
        end)
    end
    task.wait(0.4)

    -- 3. Return to Base Nest
    stabilize()
    root.CFrame = CFrame.new(home + Vector3.new(0, 5, 0))
    stabilize()
    notify("Steal Success!", "Delivered " .. data.Name .. " to Base!")
end

-- Auto Steal Loop (Safe interval, zero crash)
task.spawn(function()
    while true do
        if autoSteal and not isStealing then
            local rares = scanRares()
            if #rares > 0 then
                isStealing = true
                doSteal(rares[1])
                task.wait(1)
                isStealing = false
            end
        end
        task.wait(2)
    end
end)

-- FPS Boost
local function applyFPSBoost()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    for _, v in ipairs(Lighting:GetDescendants()) do
        if v:IsA("PostEffect") then v.Enabled = false end
    end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Material = Enum.Material.SmoothPlastic
            v.CastShadow = false
        elseif v:IsA("Decal") then
            v.Transparency = 1
        end
    end
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    notify("FPS Booster", "Smooth low-detail mode enabled!")
end

