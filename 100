            empty.Font = Enum.Font.Gotham
            empty.TextSize = 10
            empty.Parent = radarContainer
            return
        end

        pEggs.CanvasSize = UDim2.new(0, 0, 0, 160 + (#eggs * 46))

        for _, data in ipairs(eggs) do
            local row = Instance.new("Frame")
            row.Size = UDim2.new(0.94, 0, 0, 40)
            row.BackgroundColor3 = Color3.fromRGB(22, 23, 30)
            row.Parent = radarContainer
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

            local stroke = Instance.new("UIStroke", row)
            stroke.Color = data.Color
            stroke.Thickness = 1.2

            local badge = Instance.new("TextLabel")
            badge.Size = UDim2.new(0, 24, 0, 24)
            badge.Position = UDim2.new(0, 6, 0.5, -12)
            badge.BackgroundColor3 = Color3.fromRGB(16, 17, 22)
            badge.Text = string.sub(data.Tier, 1, 1)
            badge.TextColor3 = data.Color
            badge.Font = Enum.Font.FredokaOne
            badge.TextSize = 13
            badge.Parent = row
            Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 4)

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0.55, 0, 1, 0)
            lbl.Position = UDim2.new(0, 36, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = string.format("%s\n[%s] | %dm away", data.Name, data.Tier, data.Distance)
            lbl.TextColor3 = data.Color
            lbl.Font = Enum.Font.GothamBold
            lbl.TextSize = 9
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = row

            -- Instant Fast Steal & Return Button
            local stealBtn = Instance.new("TextButton")
            stealBtn.Size = UDim2.new(0.3, 0, 0, 26)
            stealBtn.Position = UDim2.new(1, -78, 0.5, -13)
            stealBtn.BackgroundColor3 = CHILLI.RedAccent
            stealBtn.Text = "⚡ STEAL"
            stealBtn.TextColor3 = CHILLI.TextPrimary
            stealBtn.Font = Enum.Font.GothamBold
            stealBtn.TextSize = 10
            stealBtn.Parent = row
            Instance.new("UICorner", stealBtn).CornerRadius = UDim.new(0, 4)

            stealBtn.MouseButton1Click:Connect(function()
                instantStealAndReturn(data)
            end)
        end
    end

    refreshRadarDisplay()

    task.spawn(function()
        while true do
            if pEggs.Visible then
                refreshRadarDisplay()
            end
            task.wait(2.5)
        end
    end)

