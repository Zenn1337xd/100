        ["legendary"] = {Tier = "Legendary", Rank = 5, Color = Color3.fromRGB(255, 160, 20)},
        ["epic"]      = {Tier = "Epic", Rank = 4, Color = Color3.fromRGB(255, 50, 50)},
        ["rare"]      = {Tier = "Rare", Rank = 3, Color = Color3.fromRGB(50, 150, 255)},
        ["common"]    = {Tier = "Common", Rank = 1, Color = Color3.fromRGB(200, 200, 200)}
    }

    local BLACKLIST = {"safe zone", "shop", "nest", "stand", "leaderboard", "ui", "zone"}

    local function isBlacklisted(str)
        local lower = string.lower(str)
        for _, b in ipairs(BLACKLIST) do
            if string.find(lower, b) then return true end
        end
        return false
    end

    local function inspectEgg(obj)
        if isBlacklisted(obj.Name) then return nil end

        local rawName = obj.Name
        local lowerName = string.lower(rawName)
        local isEgg = string.find(lowerName, "egg")
        local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
        local promptText = prompt and string.lower((prompt.ObjectText or "") .. " " .. (prompt.ActionText or "")) or ""

        if not isEgg and string.find(promptText, "egg") then
            isEgg = true
            rawName = prompt.ObjectText ~= "" and prompt.ObjectText or rawName
            lowerName = string.lower(rawName)
        end

        local billboardText = ""
        for _, lbl in ipairs(obj:GetDescendants()) do
            if lbl:IsA("TextLabel") and lbl.Text ~= "" and not isBlacklisted(lbl.Text) then
                billboardText = billboardText .. " " .. string.lower(lbl.Text)
                if string.find(string.lower(lbl.Text), "egg") then
                    isEgg = true
                    rawName = lbl.Text
                    lowerName = string.lower(rawName)
                end
            end
        end

        if not isEgg then return nil end

        local foundTier = "Common"
        local foundRank = 1
        local foundColor = Color3.fromRGB(200, 200, 200)

        local combined = lowerName .. " " .. promptText .. " " .. billboardText
        for key, data in pairs(RARITY_RANKS) do
            if string.find(combined, key) then
                if data.Rank > foundRank then
                    foundTier = data.Tier
                    foundRank = data.Rank
                    foundColor = data.Color
                end
            end
        end

        local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
        if not part or isInsideMyBase(part.Position) then return nil end

        return {
            Object = obj,
            Part = part,
            Name = rawName,
            Tier = foundTier,
            Rank = foundRank,
            Color = foundColor
        }
    end

    local function scanAllEggs()
        local results = {}
        local seen = {}
        local root = character and character:FindFirstChild("HumanoidRootPart")

        for _, item in ipairs(workspace:GetDescendants()) do
            if item:IsA("Model") or (item:IsA("BasePart") and string.find(string.lower(item.Name), "egg")) then
                local data = inspectEgg(item)
                if data and not seen[data.Part] then
                    seen[data.Part] = true
                    data.Distance = root and math.floor((root.Position - data.Part.Position).Magnitude * 0.28) or 0
                    table.insert(results, data)
                end
            end
        end

        table.sort(results, function(a, b)
            if a.Rank ~= b.Rank then return a.Rank > b.Rank end
            return a.Distance < b.Distance
        end)
        return results
    end

    -- =======================================================
    -- INSTANT STEAL & RETURN
    -- =======================================================
    local isStealing = false
    local autoSteal = false

    local function instantStealAndReturn(eggData)
        if isStealing then return end
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root or not eggData.Part or not eggData.Part.Parent then return end

        isStealing = true
        local home = getMyBasePos()

        if antiGuardEnabled then
            sleepGuards()
        end

        stabilize()
        root.CFrame = eggData.Part.CFrame * CFrame.new(0, 3, 0)
        stabilize()
        task.wait(0.1)

        local prompt = eggData.Object:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            if fireproximityprompt then
                fireproximityprompt(prompt, 0)
            else
                prompt:InputHoldBegin()
                task.wait(0.15)
                prompt:InputHoldEnd()
            end
        end

        if firetouchinterest then
            pcall(function()
                firetouchinterest(root, eggData.Part, 0)
                task.wait(0.04)
                firetouchinterest(root, eggData.Part, 1)
            end)
        end
        task.wait(0.2)

        stabilize()
        root.CFrame = CFrame.new(home + Vector3.new(0, 5, 0))
        stabilize()
        notify("Steal Success!", "Delivered " .. eggData.Name .. " to Nest!")
        task.wait(0.5)
        isStealing = false
    end

    -- Auto Steal Loop
    task.spawn(function()
        while true do
            if autoSteal and not isStealing then
                local eggs = scanAllEggs()
                for _, egg in ipairs(eggs) do
                    if egg.Rank >= 5 and not isInsideMyBase(egg.Part.Position) then
                        instantStealAndReturn(egg)
                        task.wait(1)
                        break
                    end
                end
            end
            task.wait(1.5)
        end
    end)

