    sLbl.TextColor3 = CHILLI.RedAccent
    sLbl.Font = Enum.Font.GothamBold
    sLbl.TextSize = 10
    sLbl.TextXAlignment = Enum.TextXAlignment.Left
    sLbl.Parent = speedBox

    local sBar = Instance.new("TextButton")
    sBar.Size = UDim2.new(0.94, 0, 0, 6)
    sBar.Position = UDim2.new(0.03, 0, 0, 26)
    sBar.BackgroundColor3 = CHILLI.ToggleOff
    sBar.Text = ""
    sBar.AutoButtonColor = false
    sBar.Parent = speedBox
    Instance.new("UICorner", sBar).CornerRadius = UDim.new(1, 0)

    local sFill = Instance.new("Frame")
    sFill.Size = UDim2.new(currentSpeed / 1000, 0, 1, 0)
    sFill.BackgroundColor3 = CHILLI.RedAccent
    sFill.BorderSizePixel = 0
    sFill.Parent = sBar
    Instance.new("UICorner", sFill).CornerRadius = UDim.new(1, 0)

    local function updateSlider(input)
        local rel = math.clamp((input.Position.X - sBar.AbsolutePosition.X) / sBar.AbsoluteSize.X, 0, 1)
        currentSpeed = math.floor(rel * 1000)
        sFill.Size = UDim2.new(rel, 0, 1, 0)
        sLbl.Text = "WalkSpeed: " .. currentSpeed .. " (0-1000)"
        if speedEnabled then updateSpeed() end
    end

    local dragging = false
    sBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateSlider(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    addCardToggle(playerCard, "Speed Boost Toggle", false, function(on)
        speedEnabled = on
        updateSpeed()
    end)
    addCardToggle(playerCard, "Infinite Jump", false, setJump)

    -- =======================================================
    -- PAGE: OPTIMIZER & SETTINGS
    -- =======================================================
    local optCard = createCategoryCard(pOptimizer, "FPS Booster")
    addCardToggle(optCard, "Disable 3D Render (Zero Lag)", false, function(on)
