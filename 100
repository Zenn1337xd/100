    addCardButton(optCard, "⚡ Boost FPS (Low Detail)", applyFPS)

    local setCard = createCategoryCard(pSettings, "Information")
    addCardButton(setCard, "Copy Owner Discord (kevan#9999)", function()
        if setclipboard then
            setclipboard("kevan#9999")
            notify("Discord", "Copied kevan#9999 to clipboard!")
        end
    end)
end

